{
  "_about": [
    "What ships in the installable product and what stays on the owner's PC.",
    "First matching rule wins; '*' matches within one folder level, '**' across levels; a folder path covers everything under it.",
    "ship: goes out as is. generalise: goes out once its owner-specific parts are made settings (the export's scrub check lists what is left).",
    "personal: the owner's own layer, never shipped. dev-only: the owner's research and eval runs. not-ours: licence or trademark keeps it out. drop: retired.",
    "Every tracked file must match a rule; `node product/export.mjs` reports any that don't."
  ],
  "rules": [
    { "path": "product", "keep": "ship", "why": "this manifest and the export" },
    { "path": "_archive", "keep": "drop", "why": "the retired ICM version" },
    { "path": "CLAUDE.md", "keep": "personal", "why": "instructions for working on the owner's own copy" },
    { "path": "README.md", "keep": "generalise", "why": "rewrite for a new user" },
    { "path": "ONBOARDING.md", "keep": "generalise", "why": "becomes the first-run wizard's script for the lead AI" },
    { "path": "AGENTS.md", "keep": "generalise", "why": "regenerated from the product's instructions" },
    { "path": "CONTRIBUTING.md", "keep": "ship" },
    { "path": "LICENSE", "keep": "generalise", "why": "licence and holder decided before release" },
    { "path": ".gitignore", "keep": "ship" },
    { "path": "install.ps1", "keep": "generalise", "why": "source user path; the installer replaces it for most people" },
    { "path": "install.sh", "keep": "generalise", "why": "source user path; the installer replaces it for most people" },

    { "path": "docs/Alfred_LinkedIn_Article.docx", "keep": "personal", "why": "the owner's article" },
    { "path": "docs/second-machine.md", "keep": "personal", "why": "the owner's own PCs" },
    { "path": "docs/how-alfred-decides.html", "keep": "generalise" },
    { "path": "docs/screenshots", "keep": "generalise", "why": "retake with a sample brain" },

    { "path": "claude-md/alfred-profile.template.md", "keep": "generalise" },
    { "path": "claude-md", "keep": "generalise", "why": "instruction templates; Claude-specific parts move to the Claude adapter" },
    { "path": "settings/settings.reference.json", "keep": "generalise", "why": "hook paths are the owner's" },
    { "path": "settings/config-policy.json", "keep": "generalise", "why": "pins the owner's model" },
    { "path": "settings/mcp.reference.json", "keep": "generalise" },

    { "path": "commands/azure-audit.md", "keep": "personal", "why": "the owner's Azure work" },
    { "path": "commands", "keep": "ship" },

    { "path": "helpers/alfred-speak-launcher.vbs", "keep": "generalise", "why": "hard-coded home folder" },
    { "path": "helpers/set-mcp-keys.ps1", "keep": "personal", "why": "the owner's MCP keys setup" },
    { "path": "helpers/weekly-audit.cmd", "keep": "personal" },
    { "path": "helpers/council-run.mjs", "keep": "drop", "why": "the council is retired" },
    { "path": "helpers/brain-handoffs.mjs", "keep": "generalise", "why": "wired to Grok by name; becomes any-AI-to-any-AI" },
    { "path": "helpers/brain-notes.mjs", "keep": "generalise", "why": "defaults the author to Grok" },
    { "path": "helpers/brain-core.mjs", "keep": "generalise", "why": "fixed to Eastern time" },
    { "path": "helpers/providers.json", "keep": "generalise", "why": "add Codex and Gemini CLI; Grok CLI as an equal seat" },
    { "path": "helpers", "keep": "ship" },

    { "path": "brain/bench", "keep": "dev-only", "why": "the owner's transcripts" },
    { "path": "brain/scripts", "keep": "dev-only", "why": "eval run tooling" },
    { "path": "brain/*eval*", "keep": "dev-only" },
    { "path": "brain/*.jsonl", "keep": "dev-only" },
    { "path": "brain/staffing-ab*", "keep": "dev-only" },
    { "path": "brain/make-staffing-fixture.mjs", "keep": "dev-only" },
    { "path": "brain/R3-FINAL-REPORT.md", "keep": "dev-only" },
    { "path": "brain/ablation-minimal-charter.md", "keep": "dev-only" },
    { "path": "brain/screenshot.js", "keep": "dev-only", "why": "hard-coded home folder" },
    { "path": "brain/Install-Alfred*.ps1", "keep": "drop", "why": "the desktop app starts the engine now" },
    { "path": "brain/Alfred-Desktop-Shortcut.ps1", "keep": "drop", "why": "the installer makes the shortcuts" },
    { "path": "brain/Alfred.cmd", "keep": "drop", "why": "the desktop app starts the engine now" },
    { "path": "brain/test", "keep": "ship" },
    { "path": "brain", "keep": "ship" },
    { "path": "desktop", "keep": "ship" },

    { "path": "skills/synced", "keep": "not-ours", "why": "copied from claude.ai; Anthropic's, all rights reserved, and holds the owner's account IDs" },
    { "path": "skills/docx", "keep": "not-ours", "why": "Anthropic proprietary licence" },
    { "path": "skills/pptx", "keep": "not-ours", "why": "Anthropic proprietary licence" },
    { "path": "skills/xlsx", "keep": "not-ours", "why": "Anthropic proprietary licence" },
    { "path": "skills/mcp-builder", "keep": "not-ours", "why": "Anthropic's; check its LICENSE.txt before shipping" },
    { "path": "skills/icm-architect", "keep": "not-ours", "why": "third party, from the retired ICM era" },
    { "path": "skills/claude", "keep": "not-ours", "why": "design style named after a trademark" },
    { "path": "skills/codex", "keep": "not-ours", "why": "design style named after a trademark" },
    { "path": "skills/pacman", "keep": "not-ours", "why": "design style named after a trademark" },
    { "path": "skills/tetris", "keep": "not-ours", "why": "design style named after a trademark" },
    { "path": "skills/sega", "keep": "not-ours", "why": "design style named after a trademark" },
    { "path": "skills/roku", "keep": "not-ours", "why": "design style named after a trademark" },
    { "path": "skills/matrix", "keep": "not-ours", "why": "design style named after a film" },

    { "path": "skills/azure-*", "keep": "personal", "why": "the owner's Azure work" },
    { "path": "skills/entra-app-registration", "keep": "personal" },
    { "path": "skills/graph-api-rest", "keep": "personal" },
    { "path": "skills/zero-cost-azure", "keep": "personal" },
    { "path": "skills/ps-http-server", "keep": "personal" },
    { "path": "skills/backtesting-frameworks", "keep": "personal", "why": "trading" },
    { "path": "skills/risk-metrics-calculation", "keep": "personal", "why": "trading" },
    { "path": "skills/hyperframes*", "keep": "personal", "why": "video" },
    { "path": "skills/media-use", "keep": "personal", "why": "video" },
    { "path": "skills/img2threejs", "keep": "personal", "why": "3D" },
    { "path": "skills/terraform-module-library", "keep": "personal" },
    { "path": "skills/helm-chart-scaffolding", "keep": "personal" },
    { "path": "skills/k8s-manifest-generator", "keep": "personal" },
    { "path": "skills/firecrawl-build", "keep": "personal", "why": "needs a paid Firecrawl key" },
    { "path": "skills/stitch", "keep": "personal" },

    { "path": "skills/project-note", "keep": "generalise", "why": "assumes the owner's vault template" },
    { "path": "skills/vault-recall", "keep": "generalise" },
    { "path": "skills/research-note", "keep": "generalise" },
    { "path": "skills/orgagent", "keep": "generalise", "why": "Claude's model tiers; needs a per-AI tier map" },
    { "path": "skills", "keep": "ship", "why": "generic skills; third-party ones keep their licence notice (checked before release)" }
  ]
}
