{
  "_comment": [
    "Org structure + placement rules for agents that cannot carry their own frontmatter.",
    "",
    "WHY THIS FILE EXISTS: plugin agents live under ~/.claude/plugins/cache/<plugin>/<ver>/agents/",
    "which the plugin system rewrites on every update. Writing tier/parent frontmatter into those",
    "files would be silently discarded the next time a plugin upgrades. Agents that DO own their",
    "file (~/.claude/agents/**) should declare tier/parent_vp/parent_mgr in frontmatter instead —",
    "frontmatter always wins over this file.",
    "",
    "RESOLUTION ORDER for an agent's manager: explicit `agents` entry -> first matching `rules`",
    "pattern (tested against name + description) -> the tier's fallback manager.",
    "",
    "Kept in sync with agents/ORG.md §3 (org table) and §7 (reuse map) — 2026-08-09 sync brought",
    "this from 7 old-style flat managers up to the current 5 VP / 16 manager structure. Same date,",
    "VPs dropped the vp- prefix (vp-cto -> cto, etc.) to read as actual C-suite; the tier is still",
    "internally 'vp', only the display/agent name changed. `system-architect` is a known",
    "approximation: ORG.md §7 has it reporting directly to `architect` (a VP, not a manager), but",
    "this file's schema only supports agent->manager placement, so it's mapped to infra-manager",
    "(the closest architecture-adjacent manager) for HUD graph placement purposes only."
  ],

  "vps": [
    { "name": "CTO",       "domain": "technology"   },
    { "name": "Architect", "domain": "architecture" },
    { "name": "COO",       "domain": "operations"   },
    { "name": "CSO",       "domain": "security"     },
    { "name": "CFO",       "domain": "data-finance" }
  ],

  "managers": [
    { "name": "backend-manager",     "vp": "CTO",       "label": "Backend / API" },
    { "name": "frontend-manager",    "vp": "CTO",       "label": "Frontend / UI" },
    { "name": "mobile-manager",      "vp": "CTO",       "label": "Mobile" },
    { "name": "docs-manager",        "vp": "CTO",       "label": "Documentation" },
    { "name": "infra-manager",       "vp": "Architect", "label": "Infrastructure" },
    { "name": "platform-manager",    "vp": "Architect", "label": "Platform / Hosting" },
    { "name": "devops-manager",      "vp": "COO",       "label": "DevOps / CI" },
    { "name": "qa-manager",          "vp": "COO",       "label": "Quality" },
    { "name": "sre-manager",         "vp": "COO",       "label": "SRE / Reliability" },
    { "name": "vendor-manager",      "vp": "COO",       "label": "Vendor / Tool Inventory" },
    { "name": "security-manager",    "vp": "CSO",       "label": "Security" },
    { "name": "appsec-manager",      "vp": "CSO",       "label": "AppSec / Supply Chain" },
    { "name": "compliance-manager",  "vp": "CSO",       "label": "Compliance" },
    { "name": "dr-manager",          "vp": "CSO",       "label": "Disaster Recovery" },
    { "name": "data-manager",        "vp": "CFO",       "label": "Data" },
    { "name": "analytics-manager",   "vp": "CFO",       "label": "Analytics / ML / Cost" },
    { "name": "quant-manager",       "vp": "CFO",       "label": "Quant / Trading" }
  ],

  "agents": {
    "azure-infra-engineer":   "infra-manager",
    "terraform-specialist":   "infra-manager",
    "windows-infra-admin":    "infra-manager",
    "system-architect":       "infra-manager",
    "database-architect":     "data-manager",
    "quant-analyst":          "quant-manager",
    "risk-manager":           "quant-manager",
    "ml-developer":           "analytics-manager",
    "api-docs":               "docs-manager",
    "mobile-dev":             "mobile-manager",
    "cicd-engineer":          "devops-manager",
    "production-validator":   "qa-manager",
    "analyst":                "qa-manager",
    "code-analyzer":          "security-manager",
    "tdd-london-swarm":       "qa-manager"
  },

  "rules": [
    { "match": "compliance|nist|nydfs|benchmark|evidence|control",         "manager": "compliance-manager" },
    { "match": "dependency|cve|supply.chain|reachab",                     "manager": "appsec-manager" },
    { "match": "security|vulnerab|threat|secret|owasp",                   "manager": "security-manager" },
    { "match": "incident|alert|monitor|uptime|availability|oncall",       "manager": "sre-manager" },
    { "match": "aks|helm|container|app service|function app|hosting",     "manager": "platform-manager" },
    { "match": "terraform|azure|kubernetes|k8s|infra|network|entra",      "manager": "infra-manager" },
    { "match": "review|test|qa|lint|simplif|validat|analy|bug|hookify",   "manager": "qa-manager" },
    { "match": "mobile|react native|ios|android",                        "manager": "mobile-manager" },
    { "match": "frontend|ui|ux|design|figma|css|react|web|impeccable",    "manager": "frontend-manager" },
    { "match": "docs|readme|runbook|openapi|documentation",              "manager": "docs-manager" },
    { "match": "ci|cd|pipeline|github|release|workflow|plugin|sdk|mcp",   "manager": "devops-manager" },
    { "match": "quant|trading|backtest|pinescript|position siz",          "manager": "quant-manager" },
    { "match": "ml|model|cost|spend|analytics",                          "manager": "analytics-manager" },
    { "match": "data|sql|database|schema|etl|pipeline",                   "manager": "data-manager" },
    { "match": "api|backend|server|endpoint|code|implement|feature",      "manager": "backend-manager" }
  ],

  "fallbackManager": "backend-manager"
}
